rules_version = '2';

// ============================================================
//  Servitech - Reglas de seguridad de Firestore
//  Cada usuario solo puede leer y escribir SUS propios datos.
//  La app guarda en:  users/{uid}/app/main
//  El comodin {document=**} es obligatorio para que la regla
//  alcance tambien a las subcolecciones (users/{uid}/app/main).
//  Sin ese comodin, Firestore responde "Missing or insufficient
//  permissions" y la sincronizacion no funciona.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demas queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
