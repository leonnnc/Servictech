rules_version = '2';

// ============================================================
//  Servitech - Reglas de seguridad de Firestore
//
//  Hay dos zonas, y solo esas dos:
//
//  1) Datos del tecnico -> users/{uid}/app/**   (solo el dueño)
//     La app guarda todo en users/{uid}/app/main. El comodin
//     {document=**} es obligatorio para que la regla alcance
//     tambien a las subcolecciones; sin el, Firestore responde
//     "Missing or insufficient permissions".
//
//  2) Todo lo demas, cerrado.
//
//  NOTA: la conformidad del cliente se firma en el sitio, dentro
//  de la app. Las subcolecciones envios/ y respuestas/ que usaba
//  el enlace publico ya no existen; si en tu proyecto quedaran
//  reglas viejas que las mencionan, no afectan a la app.
//
//  IMPORTANTE: estas reglas hay que PUBLICARLAS en la consola de
//  Firebase (Firestore Database -> Reglas -> Publicar). Con las
//  reglas por defecto, la sincronizacion falla con
//  "Missing or insufficient permissions".
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 1. Datos del tecnico ----------
    match /users/{uid}/app/{document=**} {
      allow read, write: if esDueno(uid);
    }

    // ---------- 2. Todo lo demas queda cerrado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // ================== Funciones auxiliares ==================

  function esDueno(uid) {
    return request.auth != null && request.auth.uid == uid;
  }
}
